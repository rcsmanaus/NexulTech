  {
    "id": "8899192abc0e4c12",
    "z": "218601acc6734eaa",
    "type": "function",
    "name": "Formatar tempo",
    "func": "var p = msg.payload;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch(e) {} }\nvar seg = (p && p.tempo_segundos !== undefined) ? p.tempo_segundos : null;\nvar nome = (p && p.leito) ? p.leito : msg.topic;\nif (seg === null) { msg.payload = { texto: 'Aguardando...' }; return msg; }\nvar m = Math.floor(seg / 60);\nvar s = seg % 60;\nvar fmt = (m > 0 ? m + 'min ' : '') + s + 's';\nmsg.payload = { nome: nome, tempo_formatado: fmt, hora: new Date().toLocaleTimeString('pt-BR') };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
